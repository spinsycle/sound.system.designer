{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sound System Designer",
  "version": "1.4.0",
  "identifier": "com.spinsycle.soundsystemdesigner",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5174 --strictPort",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../packages/app/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Sound System Designer", "width": 1280, "height": 860, "minWidth": 420, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "Copyright (C) 2026 Spinsycle. AGPL-3.0-only.",
    "category": "Utility",
    "shortDescription": "Design loudspeaker enclosures and whole sound systems",
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["English"] } }
  }
}
